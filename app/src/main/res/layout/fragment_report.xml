<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="24dp"
                android:orientation="horizontal">

                <View
                    android:layout_width="24dp"
                    android:layout_height="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_dot_active" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_dot_inactive" />

                <View
                    android:layout_width="8dp"
                    android:layout_height="4dp"
                    android:background="@drawable/bg_dot_inactive" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Report Flood Incident"
                android:textColor="#0F2040"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="24dp"
                android:gravity="center"
                android:text="Your report helps emergency responders and citizens stay informed."
                android:textColor="#5A7A99"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonFloodDemo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="Try Flood-Level Demo"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                app:backgroundTint="#2563EB"
                app:cornerRadius="16dp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp">

                        <androidx.fragment.app.FragmentContainerView
                            android:id="@+id/map"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/buttonAutoDetect"
                            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|center_horizontal"
                            android:layout_marginBottom="16dp"
                            android:text="Auto-detect My Location"
                            android:textAllCaps="false"
                            android:textColor="#2563EB"
                            app:backgroundTint="#FFFFFF"
                            app:cornerRadius="24dp"
                            app:icon="@drawable/ic_location"
                            app:iconSize="16dp"
                            app:iconTint="#2563EB" />
                    </androidx.cardview.widget.CardView>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="CURRENT ADDRESS"
                        android:textColor="#5A7A99"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:cardBackgroundColor="#F3F4F6"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp">

                        <TextView
                            android:id="@+id/textViewAddress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="16dp"
                            android:text="Detecting location..."
                            android:textColor="#1F2937"
                            android:textSize="14sp" />
                    </androidx.cardview.widget.CardView>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="FLOOD DEPTH / PARAMETER"
                        android:textColor="#5A7A99"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                    <RadioGroup
                        android:id="@+id/radioGroupFloodLevel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:checkedButton="@id/radioDepthSafe"
                        android:orientation="vertical">

                        <RadioButton
                            android:id="@+id/radioDepthSafe"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="0-5 cm - Passable"
                            android:textColor="#1F2937"
                            android:textSize="14sp" />

                        <RadioButton
                            android:id="@+id/radioDepthMotorcycle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="6-15 cm - Motorcycles not advised"
                            android:textColor="#1F2937"
                            android:textSize="14sp" />

                        <RadioButton
                            android:id="@+id/radioDepthSmallCars"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="16-30 cm - Small cars not advised"
                            android:textColor="#1F2937"
                            android:textSize="14sp" />

                        <RadioButton
                            android:id="@+id/radioDepthLargeVehicles"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="31-50 cm - Only large vehicles"
                            android:textColor="#1F2937"
                            android:textSize="14sp" />

                        <RadioButton
                            android:id="@+id/radioDepthClosed"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="50+ cm - Not passable"
                            android:textColor="#1F2937"
                            android:textSize="14sp" />
                    </RadioGroup>

                    <TextView
                        android:id="@+id/textVehiclePassability"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="#E0F2FE"
                        android:padding="12dp"
                        android:text="0-5 cm: Passable"
                        android:textColor="#075985"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_dashed_border"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="32dp">

                <ImageView
                    android:id="@+id/capturePlaceholder"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_camera"
                    app:tint="#2563EB" />

                <TextView
                    android:id="@+id/captureTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Capture Visual Proof"
                    android:textColor="#0F2040"
                    android:textStyle="bold" />

                <ImageView
                    android:id="@+id/capturedPhotoPreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:adjustViewBounds="true"
                    android:maxHeight="360dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="Photo selected for this flood report"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/photoAnalysisResult"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:accessibilityLiveRegion="polite"
                    android:textColor="#0F2040"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonGallery"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="Open Camera"
                    android:textColor="#FFFFFF"
                    app:backgroundTint="#2563EB"
                    app:icon="@drawable/ic_camera"
                    app:iconTint="#FFFFFF" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonSubmit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:padding="16dp"
                android:text="Submit Flood Report"
                android:textStyle="bold"
                app:backgroundTint="#2563EB"
                app:cornerRadius="16dp" />
        </LinearLayout>
    </ScrollView>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="#2563EB"
        android:visibility="gone" />
</FrameLayout>
