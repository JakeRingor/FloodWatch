<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/reportDetailsImage"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginBottom="16dp"
            android:background="#E8EEF5"
            android:contentDescription="@string/flood_report_photo"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <TextView
            android:id="@+id/reportDetailsLevel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:textColor="#B91C1C"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/reportDetailsAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:textColor="#0F2040"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/reportDetailsPassability"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:textColor="#334E68"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/reportDetailsDepth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:textColor="#334E68"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/reportDetailsDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:lineSpacingMultiplier="1.25"
            android:textColor="#526D82"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/reportDetailsCoordinates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:textColor="#7890A6"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/reportDetailsDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#7890A6"
            android:textSize="12sp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
