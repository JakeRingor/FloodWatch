<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4F8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- FLOOD ALERTS SECTION -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📢 Flood Alerts"
            android:textSize="18sp"
            android:textColor="#1A2E4A"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/textViewEmptyAlerts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No active alerts."
            android:textColor="#8AACC8"
            android:textSize="13sp"
            android:gravity="center"
            android:padding="16dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/layoutAlerts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="24dp" />

        <!-- VERIFIED REPORTS SECTION -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📋 Verified Flood Reports"
            android:textSize="18sp"
            android:textColor="#1A2E4A"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/textViewEmptyReports"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No verified reports yet."
            android:textColor="#8AACC8"
            android:textSize="13sp"
            android:gravity="center"
            android:padding="16dp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewReports"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>